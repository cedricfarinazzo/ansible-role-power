# {{ ansible_managed }}
# ups <ups@host[:port]> | charge <min %> | timeout <seconds> | delay <seconds> | broadcast <address> | mac <address>
ups {{ (power_monitors | selectattr('name', 'equalto', power_wake_ups) | map(attribute='target') | first) | default('') }}
charge {{ power_wake_min_charge | int }}
timeout {{ power_wake_timeout_sec | int }}
delay {{ power_wake_delay_sec | int }}
broadcast {{ power_wake_broadcast }}
{% for m in power_wake_macs %}
mac {{ m }}
{% endfor %}
