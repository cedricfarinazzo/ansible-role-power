# {{ ansible_managed }}
[Unit]
Description=Wake the hosts once their UPS battery is charged enough
Wants=network-online.target nut-server.service
After=network-online.target nut-server.service

[Service]
Type=exec
ExecStart=/usr/local/sbin/power-wake /etc/nut/power-wake.conf

[Install]
WantedBy=multi-user.target
