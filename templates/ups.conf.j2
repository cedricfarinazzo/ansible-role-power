# {{ ansible_managed }}
maxretry = 3
{% for u in power_ups %}

[{{ u.name }}]
  driver = {{ u.driver }}
  port = {{ u.port | default('auto') }}
{% if u.desc is defined %}
  desc = "{{ u.desc }}"
{% endif %}
{% for k, v in (u.options | default({})).items() %}
  {{ k }} = "{{ v }}"
{% endfor %}
{% endfor %}
