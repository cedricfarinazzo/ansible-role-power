#!/usr/bin/env bash
# At boot: waits until the UPS charge reaches the threshold, then wakes every MAC by Wake-on-LAN, delay seconds
# apart. Hosts already up ignore the packet. No MAC = nothing to do.
set -uo pipefail

conf=${1:?usage: power-wake <wake.conf>}
ups="" charge=80 timeout=3600 delay=0 bcast="" macs=()
while read -r k v; do
  case $k in
    ups) ups=$v ;; charge) charge=$v ;; timeout) timeout=$v ;; delay) delay=$v ;; broadcast) bcast=$v ;;
    mac) macs+=("$v") ;;
  esac
done < <(grep -v '^#' "$conf")
if (( ${#macs[@]} == 0 )); then echo "no host to wake"; exit 0; fi

end=$((SECONDS + timeout))
# charge 0: wake at once, even on a UPS that reports no battery.charge
while (( charge > 0 )); do
  now=$(upsc "$ups" battery.charge 2>/dev/null) || now=""
  now=${now%%.*}
  if [[ $now =~ ^[0-9]+$ ]] && (( now >= charge )); then break; fi
  if (( SECONDS >= end )); then echo "battery ${now:-unknown}% below ${charge}% after ${timeout}s: not waking" >&2; exit 1; fi
  sleep "${POWER_WAKE_POLL_SEC:-30}"
done
echo "battery ${now:-unread}% >= ${charge}%: waking ${macs[*]}"
args=()
if [[ -n $bcast ]]; then args=(-i "$bcast"); fi
status=0
for i in "${!macs[@]}"; do
  if (( i > 0 && delay > 0 )); then sleep "$delay"; fi
  wakeonlan "${args[@]}" "${macs[$i]}" || status=1
done
exit "$status"
