#!/usr/bin/env bash
# Wakes hosts by Wake-on-LAN, each once its own UPS's battery.charge reaches its threshold, delay seconds apart.
# power-wake <conf>          every host (at boot)
# power-wake <conf> <ups>    the hosts of that UPS only (power-notify, when it is back on mains)
# Hosts already up ignore the packet. Exits 1 if a host was not woken before the timeout.
set -uo pipefail

conf=${1:?usage: power-wake <conf> [<ups@host[:port]>]}
only=${2:-}
timeout=3600 delay=0 macs=() targets=() charges=() bcasts=()
while read -r k a b c d; do
  case $k in
    timeout) timeout=$a ;;
    delay) delay=$a ;;
    host) if [[ -z $only || $b == "$only" ]]; then macs+=("$a"); targets+=("$b"); charges+=("$c"); bcasts+=("$d"); fi ;;
  esac
done < <(grep -v '^#' "$conf")
if (( ${#macs[@]} == 0 )); then echo "no host to wake${only:+ on $only}"; exit 0; fi

# One run per UPS at a time: a UPS flapping on and off mains does not stack waiters
lock=${POWER_WAKE_LOCK_DIR:-/run/nut}/power-wake-${only:-all}.lock
exec 9> "${lock//[^A-Za-z0-9._\/-]/_}" 2>/dev/null && { flock -n 9 || { echo "already waking ${only:-all}"; exit 0; }; }

end=$((SECONDS + timeout))
woke=0
pending=("${!macs[@]}")
while (( ${#pending[@]} > 0 )); do
  declare -A now=()
  left=()
  for i in "${pending[@]}"; do
    t=${targets[$i]}
    if (( charges[i] > 0 )) && [[ -z ${now[$t]+x} ]]; then
      v=$(upsc "$t" battery.charge 2>/dev/null) || v=""
      now[$t]=${v%%.*}
    fi
    n=${now[$t]:-}
    if (( charges[i] == 0 )) || { [[ $n =~ ^[0-9]+$ ]] && (( n >= charges[i] )); }; then
      if (( woke > 0 && delay > 0 )); then sleep "$delay"; fi
      args=()
      if [[ ${bcasts[$i]} != - ]]; then args=(-i "${bcasts[$i]}"); fi
      echo "$t at ${n:-unread}% >= ${charges[$i]}%: waking ${macs[$i]}"
      wakeonlan "${args[@]}" "${macs[$i]}" || echo "${macs[$i]}: wakeonlan failed" >&2
      woke=$((woke + 1))
    else
      left+=("$i")
    fi
  done
  unset now
  pending=("${left[@]}")
  (( ${#pending[@]} == 0 )) && break
  if (( SECONDS >= end )); then
    for i in "${pending[@]}"; do echo "${macs[$i]}: ${targets[$i]} below ${charges[$i]}% after ${timeout}s, not woken" >&2; done
    exit 1
  fi
  sleep "${POWER_WAKE_POLL_SEC:-30}"
done
