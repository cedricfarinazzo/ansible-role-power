#!/usr/bin/env bash
# NUT SHUTDOWNCMD on low battery: stops each target in order over SSH (the key's forced command
# does the shutdown), waits until it stops answering ping, then stops this host. Never aborts on one target.
set -uo pipefail

conf=${POWER_SHUTDOWN_CONF:-/etc/power/shutdown.conf}
key=${POWER_KEY:-/etc/power/id_ed25519}
wait_sec=300
log() { logger -t power-shutdown -- "$*"; echo "$*"; }

while read -r kind a b c; do
  case $kind in
    wait) wait_sec=$a ;;
    target)
      log "stopping $a"
      # accept-new: a target's first key is learnt here; a changed key still refuses
      ssh -n -i "$key" -p "$b" -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile=/etc/power/known_hosts "$c@$a" || log "$a: ssh failed, waiting anyway"
      end=$((SECONDS + wait_sec))
      while ping -c 1 -W 2 "$a" > /dev/null 2>&1; do
        if (( SECONDS >= end )); then log "$a: still up after ${wait_sec}s, going on"; break; fi
        sleep 5
      done
      ;;
  esac
done < <(grep -v '^#' "$conf")
log "stopping this host"
exec ${POWER_POWEROFF:-/sbin/shutdown -h +0}
